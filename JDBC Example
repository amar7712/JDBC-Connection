import java.sql.*;

public class JDBCExample {

    // Database details
    static final String JDBC_URL = "jdbc:mysql://localhost:3306/mydatabase";
    static final String USERNAME = "root";
    static final String PASSWORD = "root";

    public static void main(String[] args) {

        String sqlQuery = "SELECT * FROM users";

        // Try-with-resources
        try (Connection connection =
                     DriverManager.getConnection(JDBC_URL, USERNAME, PASSWORD);
             Statement statement = connection.createStatement();
             ResultSet resultSet = statement.executeQuery(sqlQuery)) {

            System.out.println("Connected to the database successfully!\n");

            // Retrieve and display records
            while (resultSet.next()) {

                int id = resultSet.getInt("id");
                String username = resultSet.getString("username");
                String email = resultSet.getString("email");

                System.out.println(
                    "User ID: " + id +
                    ", Username: " + username +
                    ", Email: " + email
                );
            }

        } catch (SQLException e) {
            System.out.println("Database connection or query failed!");
            System.out.println("Error: " + e.getMessage());
        }
    }
}
